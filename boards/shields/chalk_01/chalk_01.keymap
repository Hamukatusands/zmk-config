#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // 0: 通常レイヤー
        default_layer {
            bindings = <
                &kp ESC   &kp Q &kp W &kp E &kp R &kp T    &kp Y &kp U &kp I     &kp O   &kp P    &kp BSPC
                &kp LSHFT &kp A &kp S &kp D &kp F &kp G    &kp H &kp J &kp K     &kp L   &kp LPAR &kp RET
                &kp LCTRL &kp Z &kp X &kp C &kp V &kp B    &kp N &kp M &kp COMMA &kp DOT &kp RPAR &kp DEL
                                &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 1 &kp GRAVE
            >;
        };

        // 1: Fnレイヤー (Fnキーを押している間)
        fn_layer {
            bindings = <
                &trans &kp ASTERISK &kp N7 &kp N8 &kp N9 &kp PLUS     &kp F8 &kp F9 &kp F10 &kp F11  &kp F12  &trans
                &trans &kp MINUS    &kp N4 &kp N5 &kp N6 &kp N0       &kp F4 &kp F5 &kp F6  &kp F7   &kp UP   &trans
                &trans &kp SLASH    &kp N1 &kp N2 &kp N3 &kp EQUAL    &kp F1 &kp F2 &kp F3  &kp LEFT &kp DOWN &kp RIGHT
                                         &trans &trans &trans       &trans &trans &trans
            >;
        };
    };
};